---
interface Props {
  theme?: 'dark' | 'light';
}
const { theme = 'dark' } = Astro.props;

const navLinks = [
  {
    label: 'Ydelser',
    href: '/ydelser',
    sub: [
      { label: 'Individuel Psykoterapi', href: '/individuel-psykoterapi' },
      { label: 'Mindfulness',            href: '/mindfulness' },
      { label: 'Kundalini Yoga',         href: '/kundalini-yoga' },
    ],
  },
  {
    label: 'Praktisk',
    href: '/praktisk-info',
    sub: [
      { label: 'Priser', href: '/priser' },
      { label: 'FAQ',    href: '/faq' },
    ],
  },
  {
    label: 'Mød Kirsten',
    href: '/moed-kirsten',
    sub: [
      { label: 'Mennesket bag',       href: '/mennesket-bag' },
      { label: 'Arbejde og baggrund', href: '/baggrund' },
    ],
  },
  { label: 'Kontakt', href: '/kontakt' },
  { label: 'Booking', href: '/book' },
];
---

<header class={`header${theme === 'light' ? ' header--light' : ''}`}>
  <div class="header__inner">
    <a href="/" class="header__logo" aria-label="Eira Studio — forside">
      <img src={theme === 'light' ? '/images/logolight.svg' : '/images/logodark.svg'} alt="Eira Studio logo" class="logo-svg" />
    </a>
    <div class="header__right">
      <a href="/book" class="header__book-btn">Book</a>
      <button class="burger" aria-label="Åbn menu" aria-expanded="false" aria-controls="menu-overlay">
        <span class="burger__line"></span>
        <span class="burger__line"></span>
        <span class="burger__line"></span>
      </button>
    </div>
  </div>
</header>

<!-- Menu Overlay -->
<div class="menu-overlay" id="menu-overlay" aria-hidden="true">
  <div class="menu-overlay__inner">

    <!-- Smal venstre kolonne med luk-knap -->
    <div class="menu-overlay__strip">
      <button class="menu-overlay__close" aria-label="Luk menu">
        <svg width="16" height="16" viewBox="0 0 20 20" fill="none">
          <line x1="2" y1="2" x2="18" y2="18" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
          <line x1="18" y1="2" x2="2" y2="18" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
        </svg>
      </button>
    </div>

    <!-- Højre indhold -->
    <div class="menu-overlay__content">

      <!-- Top: navigation -->
      <nav class="menu-overlay__nav">
        <ul>
          {navLinks.map((link, i) => (
            <li class={link.sub ? 'has-sub-item' : ''}>
              <a href={link.href} class="menu-link">
                {link.label}
              </a>
              {link.sub && (
                <button class="sub-toggle" data-index={String(i)} aria-label="Vis undermenu">
                  <svg class="sub-icon-plus" width="22" height="22" viewBox="0 0 28 28" fill="none">
                    <circle cx="14" cy="14" r="13" stroke="currentColor" stroke-width="1"/>
                    <line x1="14" y1="8" x2="14" y2="20" stroke="currentColor" stroke-width="1" stroke-linecap="round"/>
                    <line x1="8" y1="14" x2="20" y2="14" stroke="currentColor" stroke-width="1" stroke-linecap="round"/>
                  </svg>
                  <svg class="sub-icon-minus" width="22" height="22" viewBox="0 0 28 28" fill="none">
                    <circle cx="14" cy="14" r="13" stroke="currentColor" stroke-width="1"/>
                    <line x1="8" y1="14" x2="20" y2="14" stroke="currentColor" stroke-width="1" stroke-linecap="round"/>
                  </svg>
                </button>
              )}
            </li>
          ))}
        </ul>
      </nav>

      <!-- Bund: sub-menuer + logo -->
      <div class="menu-overlay__sub-section">
        {navLinks.map((link, i) => link.sub && (
          <div class="sub-menu" data-sub={String(i)} aria-hidden="true">
            <ul>
              {link.sub.map(sub => (
                <li><a href={sub.href} class="sub-link">{sub.label}</a></li>
              ))}
            </ul>
          </div>
        ))}
        <a href="/" class="menu-overlay__logo" aria-label="Eira Studio — forside">
          <img src="/images/logolight.svg" alt="Eira Studio logo" />
        </a>
      </div>

    </div>
  </div>
</div>

<style>
/* ---- Header ---- */
.header {
  position: fixed;
  top: 0; left: 0; right: 0;
  z-index: 100;
  padding: 1rem 1.25rem;
}

.header__inner {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
}

.header__logo { display: block; }

.logo-svg { width: 52px; height: auto; }

.header__right {
  display: flex;
  align-items: center;
  gap: 0.75rem;
}

.header__book-btn {
  font-family: var(--font-body);
  font-size: 0.8rem;
  font-weight: 400;
  color: #5C2D1E;
  border: 1px solid #5C2D1E;
  border-radius: 50px;
  padding: 0.4rem 1.1rem;
  text-decoration: none;
  transition: background-color 0.2s, color 0.2s;
}

.header__book-btn:hover {
  background-color: #5C2D1E;
  color: var(--color-primary);
}

.header--light .header__book-btn {
  color: var(--color-primary);
  border-color: var(--color-primary);
}

.header--light .header__book-btn:hover {
  background-color: var(--color-primary);
  color: var(--color-dark);
}

/* Burger */
.burger {
  background: none;
  border: none;
  cursor: pointer;
  display: flex;
  flex-direction: column;
  gap: 5px;
  padding: 6px;
  margin-top: 4px;
}

.burger__line {
  display: block;
  width: 26px;
  height: 1.5px;
  background-color: #5C2D1E;
  transition: transform 0.3s ease, opacity 0.3s ease;
  transform-origin: center;
}

.burger.is-active .burger__line:nth-child(1) { transform: translateY(6.5px) rotate(45deg); }
.burger.is-active .burger__line:nth-child(2) { opacity: 0; transform: scaleX(0); }
.burger.is-active .burger__line:nth-child(3) { transform: translateY(-6.5px) rotate(-45deg); }

.header--light .burger__line {
  background-color: var(--color-primary);
}

/* Når header--light scroller forbi hero → skift til dark */
.header--light.is-scrolled .burger__line {
  background-color: #5C2D1E;
}

.header--light.is-scrolled .header__book-btn {
  color: #5C2D1E;
  border-color: #5C2D1E;
}

.header--light.is-scrolled .header__book-btn:hover {
  background-color: #5C2D1E;
  color: var(--color-primary);
}

/* Når dark header scroller ned til vslider → skift til light */
.header.is-light-scroll .burger__line {
  background-color: var(--color-primary);
}

.header.is-light-scroll .header__book-btn {
  color: var(--color-primary);
  border-color: var(--color-primary);
}

.header.is-light-scroll .header__book-btn:hover {
  background-color: var(--color-primary);
  color: var(--color-dark);
}

/* ---- Menu Overlay ---- */
.menu-overlay {
  position: fixed;
  inset: 0;
  z-index: 200;
  background-color: var(--color-accent-1);
  color: var(--color-primary);
  opacity: 0;
  pointer-events: none;
  transition: opacity 0.4s ease;
}

.menu-overlay.is-open {
  opacity: 1;
  pointer-events: all;
}

/* Indre: smal kolonne + højre indhold side om side */
.menu-overlay__inner {
  height: 100%;
  display: flex;
  flex-direction: row;
}

/* Smal venstre kolonne */
.menu-overlay__strip {
  width: 56px;
  flex-shrink: 0;
  border-right: 1px solid var(--color-primary);
  display: flex;
  align-items: flex-start;
  justify-content: center;
  padding-top: 1rem;
}

.menu-overlay__close {
  background: none;
  border: none;
  color: var(--color-primary);
  cursor: pointer;
  padding: 4px;
}

/* Højre indhold: nav øverst, sub-section nederst */
.menu-overlay__content {
  flex: 1;
  display: flex;
  flex-direction: column;
  overflow: hidden;
}

/* Nav */
.menu-overlay__nav {
  padding: 2rem 1.5rem 1.5rem;
}

.menu-overlay__nav ul {
  list-style: none;
  display: flex;
  flex-direction: column;
  gap: 1.25rem;
}

.has-sub-item {
  display: flex;
  align-items: center;
  gap: 0.6rem;
}

.menu-link {
  font-family: var(--font-heading);
  font-size: clamp(1.1rem, 5vw, 2rem);
  font-weight: 300;
  letter-spacing: normal;
  text-transform: uppercase;
  color: var(--color-primary);
  text-decoration: none;
}

.menu-link:hover,
.menu-link.is-active {
  font-weight: 700;
  text-decoration: underline;
  text-underline-offset: 4px;
}

.sub-toggle {
  background: none;
  border: none;
  color: var(--color-primary);
  cursor: pointer;
  padding: 4px;
  display: flex;
  align-items: center;
  opacity: 0.7;
  transition: opacity 0.2s, transform 0.25s ease;
}

.sub-toggle:hover {
  opacity: 1;
}

.sub-icon-minus { display: none; }

.sub-toggle.is-active .sub-icon-plus  { display: none; }
.sub-toggle.is-active .sub-icon-minus { display: block; }

/* Sub-section */
.menu-overlay__sub-section {
  flex: 1;
  border-top: 1px solid var(--color-primary);
  position: relative;
  display: flex;
  flex-direction: column;
  justify-content: flex-end;
  padding: 1.5rem;
}

/* Sub-menuer */
.sub-menu {
  position: absolute;
  top: 1.5rem;
  left: 1.5rem;
  opacity: 0;
  pointer-events: none;
  transition: opacity 0.25s ease;
}

.sub-menu.is-visible {
  opacity: 1;
  pointer-events: all;
}

.sub-menu ul {
  list-style: none;
  display: flex;
  flex-direction: column;
  gap: 0.85rem;
}

.sub-link {
  font-family: var(--font-heading);
  font-size: clamp(0.85rem, 3vw, 1.2rem);
  font-weight: 400;
  color: var(--color-primary);
  text-decoration: none;
  letter-spacing: normal;
}

.sub-link:hover {
  text-decoration: underline;
  text-underline-offset: 4px;
}

/* Logo */
.menu-overlay__logo {
  display: flex;
  justify-content: flex-end;
}

.menu-overlay__logo img {
  width: clamp(60px, 18vw, 120px);
  height: auto;
}

/* Desktop */
@media (min-width: 768px) {
  .menu-overlay__inner {
    flex-direction: column;
  }

  .menu-overlay__strip {
    width: auto;
    border-right: none;
    border-bottom: none;
    justify-content: flex-end;
    padding: 1rem 1.25rem 0.75rem 0;
  }

  .menu-overlay__content {
    flex: 1;
    display: grid;
    grid-template-columns: auto 1fr;
    border-top: 1px solid var(--color-primary);
  }

  .menu-overlay__nav {
    padding: 2rem 2rem 2rem 1.25rem;
    border-right: 1px solid var(--color-primary);
  }

  .menu-overlay__nav ul {
    gap: 1.5rem;
  }

  .menu-overlay__sub-section {
    border-top: none;
    padding: 1.5rem;
  }

  .sub-menu {
    top: 2rem;
    left: 1.5rem;
  }
}
</style>

<script>
const burger  = document.querySelector('.burger') as HTMLButtonElement;
const overlay = document.querySelector('.menu-overlay') as HTMLElement;
const close   = document.querySelector('.menu-overlay__close') as HTMLButtonElement;

function openMenu() {
  overlay.classList.add('is-open');
  overlay.setAttribute('aria-hidden', 'false');
  burger.classList.add('is-active');
  burger.setAttribute('aria-expanded', 'true');
  document.body.style.overflow = 'hidden';
}

function closeMenu() {
  overlay.classList.remove('is-open');
  overlay.setAttribute('aria-hidden', 'true');
  burger.classList.remove('is-active');
  burger.setAttribute('aria-expanded', 'false');
  document.body.style.overflow = '';
  closeAllSubs();
}

function closeAllSubs() {
  document.querySelectorAll('.sub-menu').forEach(s => s.classList.remove('is-visible'));
  document.querySelectorAll('.menu-link').forEach(l => l.classList.remove('is-active'));
  document.querySelectorAll('.sub-toggle').forEach(b => b.classList.remove('is-active'));
}

burger.addEventListener('click', openMenu);
close.addEventListener('click', closeMenu);

document.querySelectorAll('.sub-toggle').forEach(btn => {
  btn.addEventListener('click', () => {
    const index = (btn as HTMLElement).dataset.index;
    const sub = document.querySelector(`.sub-menu[data-sub="${index}"]`);
    const isOpen = sub?.classList.contains('is-visible');
    closeAllSubs();
    if (!isOpen && sub) {
      sub.classList.add('is-visible');
      btn.classList.add('is-active');
      btn.previousElementSibling?.classList.add('is-active');
    }
  });
});

overlay.querySelectorAll('.sub-link').forEach(link => {
  link.addEventListener('click', closeMenu);
});

overlay.querySelectorAll('.menu-link:not(.has-sub)').forEach(link => {
  link.addEventListener('click', closeMenu);
});

const header = document.querySelector('.header') as HTMLElement;
const logo   = header?.querySelector('.logo-svg') as HTMLImageElement;

// Forsiden: light → dark når hero scroller ud af syne
const hero = document.querySelector('.hero') as HTMLElement;
if (header?.classList.contains('header--light') && hero) {
  new IntersectionObserver(([entry]) => {
    if (entry.isIntersecting) {
      header.classList.remove('is-scrolled');
      if (logo) logo.src = '/images/logolight.svg';
    } else {
      header.classList.add('is-scrolled');
      if (logo) logo.src = '/images/logodark.svg';
    }
  }, { threshold: 0 }).observe(hero);
}

// Ydelsessider: dark → light når intro-sektionen forlader viewport
const vslider = document.querySelector('.vslider') as HTMLElement;
if (!header?.classList.contains('header--light') && vslider) {
  const introSection = document.querySelector('main section:first-child') as HTMLElement;
  if (introSection) {
    new IntersectionObserver(([entry]) => {
      if (entry.isIntersecting) {
        header.classList.remove('is-light-scroll');
        if (logo) logo.src = '/images/logodark.svg';
      } else {
        header.classList.add('is-light-scroll');
        if (logo) logo.src = '/images/logolight.svg';
      }
    }, { threshold: 0 }).observe(introSection);
  }
}
</script>
