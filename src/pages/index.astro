---
import BaseLayout from '../layouts/BaseLayout.astro';
import ServiceCards from '../components/ServiceCards.astro';
---

<BaseLayout title="Forside" headerTheme="light">

  <!-- Hero -->
  <section class="hero">
    <div class="hero__video-wrap">
      <iframe
        class="hero__video"
        src="https://www.youtube.com/embed/IDp1Z5k00pA?autoplay=1&mute=1&loop=1&playlist=IDp1Z5k00pA&controls=0&showinfo=0&rel=0&modestbranding=1&iv_load_policy=3&playsinline=1"
        allow="autoplay; encrypted-media"
        allowfullscreen
        style="border: 0"
        width="1920"
        height="1080"
        title="Hero video"
      ></iframe>
    </div>
    <div class="hero__overlay">
      <div class="hero__content">
        <img src="/images/logo-landing.svg" alt="Eira Studio" class="hero__logo-mark" width="678" height="682" />
      </div>
      <a href="#om-eira" class="hero__cta">læs mere</a>
    </div>
  </section>

  <!-- Eira definition -->
  <section class="definition" id="om-eira">
    <h2 class="definition__word">Eira</h2>
    <div class="definition__meta">
      <span>(substantiv)</span>
      <span class="definition__pronunciation">(udtales ej-ra)</span>
    </div>
    <hr class="definition__rule" />
    <p class="definition__text">
      En tilstand af ro, heling og nænsom omsorg.<br />
      En stille energi, der skaber balance mellem krop og sind.
    </p>
  </section>

  <!-- Ydelser / service cards -->
  <section class="services-section">
    <ServiceCards />
    <div class="services-section__cta">
      <a href="/ydelser" class="btn-dark">se ydelser</a>
    </div>
  </section>

  <!-- Book intro -->
  <section class="intro-section">
    <div class="intro-section__topbar">
      <a href="/book" class="btn-dark">Book her</a>
    </div>
    <div class="intro-section__grid">
      <div class="intro-section__text">
        <h2 class="intro-section__heading">Book en gratis intro samtale</h2>
        <p class="intro-section__body">
          Måske mærker du, at noget kalder på forandring — eller måske har du bare brug for et trygt sted at starte. I en gratis introsamtale mærker vi efter, om jeg er den rette til at støtte dig på din vej.
        </p>
      </div>
      <div class="intro-section__image-wrap">
        <img src="/images/forside-stemning-1_result.webp" alt="Intro samtale" class="intro-section__img" width="557" height="371" />
      </div>
    </div>
  </section>

  <!-- Testimonial -->
  <section class="testimonial">
    <p class="testimonial__name">Charlotte, projektleder</p>
    <p class="testimonial__role">tidl. klient</p>
    <blockquote class="testimonial__quote">
      "Jeg har gået hos Kirsten on / off igennem de sidste 13 år, og jeg vender altid tilbage, når jeg har brug for en god snak om livets udfordringer. Kirsten er som den kærlige mor; omsorgsfuld, lyttende, kærlig, favnende og har altid gode råd til, hvordan jeg kommer videre, så jeg ikke føler mig "stuck" i livet."
    </blockquote>
  </section>

  <!-- Om mig teaser -->
  <section class="om-mig-teaser">
    <div class="om-mig-teaser__left">
      <a href="/moed-kirsten" class="btn-dark om-mig-teaser__btn">Mød Kirsten</a>
      <img src="/images/forside-stemning-2_result.webp" alt="Kirsten" class="om-mig-teaser__img" width="557" height="371" />
    </div>
    <div class="om-mig-teaser__text">
      <h2 class="om-mig-teaser__heading">Lær mig bedre at kende</h2>
      <p class="om-mig-teaser__body">
        Som psykoterapeut arbejder jeg med at skabe et trygt og nærværende rum, hvor der er plads til både refleksion, følelser og udvikling. Jeg møder mennesker med respekt, nysgerrighed og et ønske om at forstå det enkelte menneskes unikke historie. Tryk for at læse mere om min profil og baggrund.
      </p>
    </div>
  </section>

</BaseLayout>

<style>
/* ── Hero ── */
.hero {
  position: relative;
  width: 100%;
  height: 100vh;
  overflow: hidden;
}

.hero__video-wrap {
  position: absolute;
  inset: 0;
  overflow: hidden;
  pointer-events: none;
}

.hero__video {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: 177.78vh;
  height: 56.25vw;
  min-width: 100%;
  min-height: 100%;
  border: none;
}

.hero__overlay {
  position: absolute;
  inset: 0;
  background: rgba(0, 0, 0, 0.35);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding-bottom: 3rem;
}

.hero__content {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 1.25rem;
  text-align: center;
  color: var(--color-primary);
  flex: 1;
  justify-content: center;
}

.hero__logo-mark {
  width: min(320px, 70vw);
  height: auto;
}

.hero__sub {
  font-family: var(--font-heading);
  font-weight: 400;
  font-size: clamp(0.7rem, 1.5vw, 0.9rem);
  letter-spacing: 0.05em;
  color: var(--color-primary);
  opacity: 0.85;
}

.hero__cta {
  font-family: var(--font-body);
  font-weight: 400;
  font-size: 0.8rem;
  color: var(--color-primary);
  border: 1px solid var(--color-primary);
  border-radius: 50px;
  padding: 0.5rem 1.75rem;
  text-decoration: none;
  transition: background-color 0.2s, color 0.2s;
}

.hero__cta:hover {
  background-color: var(--color-primary);
  color: var(--color-dark);
}

/* ── Eira definition ── */
.definition {
  min-height: 830px;
  display: flex;
  flex-direction: column;
  justify-content: center;
  padding: 5rem var(--padding-inline);
  background-color: var(--color-primary);
  max-width: 900px;
  margin-inline: auto;
}

.definition__word {
  font-family: var(--font-body);
  font-size: 90px;
  font-weight: 700;
  font-style: italic;
  color: var(--color-secondary);
  line-height: 1;
  margin-bottom: 0.25rem;
}

.definition__meta {
  display: flex;
  gap: 2rem;
  font-family: var(--font-body);
  font-size: 25px;
  color: var(--color-secondary);
}

.definition__pronunciation {
  font-style: italic;
}

.definition__rule {
  border: none;
  border-top: 1px solid var(--color-secondary);
  margin: 1rem 0 1.5rem;
  opacity: 0.4;
}

.definition__text {
  font-family: var(--font-heading);
  font-weight: 400;
  font-size: 20px;
  line-height: 1.6;
  color: var(--color-secondary);
  opacity: 0.85;
}

/* ── Services section ── */
.services-section {
  background-color: var(--color-primary);
}

.services-section__cta {
  display: flex;
  justify-content: center;
  padding: 2rem var(--padding-inline);
  background-color: var(--color-primary);
}

/* ── Shared dark button ── */
.btn-dark {
  font-family: var(--font-heading);
  font-weight: 400;
  font-size: 0.8rem;
  color: var(--color-primary);
  background-color: var(--color-accent-1);
  border-radius: 50px;
  padding: 0.6rem 1.75rem;
  text-decoration: none;
  display: inline-block;
  transition: opacity 0.2s;
}

.btn-dark:hover {
  opacity: 0.85;
}

/* ── Book intro ── */
.intro-section {
  padding-top: 4rem;
  padding-bottom: 4rem;
  background-color: var(--color-primary);
}

.intro-section__topbar {
  display: flex;
  justify-content: flex-end;
  margin-bottom: 2rem;
  padding-inline: var(--padding-inline);
}

.intro-section__grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  min-height: 350px;
}

.intro-section__text {
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  padding-left: var(--padding-inline);
  padding-right: 3rem;
  padding-bottom: 1rem;
}

.intro-section__heading {
  font-family: var(--font-body);
  font-weight: 700;
  font-style: normal;
  font-size: clamp(1.5rem, 3vw, 2.2rem);
  color: var(--color-secondary);
  line-height: 1.2;
}

.intro-section__body {
  font-family: var(--font-heading);
  font-weight: 400;
  font-size: 0.8rem;
  line-height: 1.8;
  color: var(--color-secondary);
  opacity: 0.8;
}

.intro-section__img {
  width: 100%;
  aspect-ratio: 3 / 2;
  object-fit: cover;
  display: block;
}

/* ── Testimonial ── */
.testimonial {
  min-height: 830px;
  padding: 5rem var(--padding-inline);
  background-color: var(--color-primary);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  text-align: center;
  gap: 0.4rem;
  max-width: 480px;
  margin-inline: auto;
}

.testimonial__name {
  font-family: var(--font-body);
  font-size: 1.1rem;
  font-weight: 700;
  color: var(--color-secondary);
}

.testimonial__role {
  font-family: var(--font-body);
  font-size: 0.9rem;
  font-style: italic;
  color: var(--color-secondary);
  opacity: 0.75;
  margin-bottom: 1.25rem;
}

.testimonial__quote {
  font-family: var(--font-heading);
  font-weight: 400;
  font-size: clamp(0.8rem, 1.4vw, 0.95rem);
  line-height: 1.9;
  color: var(--color-secondary);
  opacity: 0.85;
  font-style: normal;
}

/* ── Om mig teaser ── */
.om-mig-teaser {
  display: grid;
  grid-template-columns: 1fr 1fr;
  background-color: var(--color-primary);
  padding-top: 4rem;
  padding-bottom: 4rem;
  gap: 4rem;
  align-items: stretch;
  min-height: 710px;
}

.om-mig-teaser__left {
  display: flex;
  flex-direction: column;
  gap: 1.5rem;
}

.om-mig-teaser__btn {
  align-self: flex-start;
}

.om-mig-teaser__img {
  width: 100%;
  aspect-ratio: 3 / 2;
  object-fit: cover;
  display: block;
}

.om-mig-teaser__text {
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  align-items: flex-end;
  text-align: right;
  padding-top: 4rem;
  padding-bottom: 1rem;
  padding-right: var(--padding-inline);
}

.om-mig-teaser__heading {
  font-family: var(--font-body);
  font-size: clamp(1.5rem, 3vw, 2.2rem);
  font-weight: 700;
  font-style: normal;
  color: var(--color-secondary);
  line-height: 1.2;
}

.om-mig-teaser__body {
  font-family: var(--font-heading);
  font-weight: 400;
  font-size: 0.8rem;
  line-height: 1.8;
  color: var(--color-secondary);
  opacity: 0.8;
}

/* ── Mobil ── */
@media (max-width: 767px) {
  .definition__word {
    font-size: clamp(3.5rem, 18vw, 90px);
  }

  .definition__meta {
    font-size: clamp(0.9rem, 4vw, 25px);
    gap: 1rem;
  }

  .definition__text {
    font-size: clamp(0.85rem, 3.5vw, 20px);
  }

  .intro-section {
    display: flex;
    flex-direction: column;
  }

  .intro-section__grid {
    grid-template-columns: 1fr;
    gap: 2rem;
    order: 1;
  }

  .intro-section__topbar {
    order: 2;
    margin-bottom: 0;
    margin-top: 1.5rem;
  }

  .intro-section__text {
    padding-right: 0;
    gap: 1.5rem;
  }

  .om-mig-teaser {
    display: flex;
    flex-direction: column;
    gap: 0;
  }

  .om-mig-teaser__text {
    order: 1;
    align-items: flex-start;
    text-align: left;
    padding-top: 1.5rem;
    padding-right: var(--padding-inline);
    padding-left: var(--padding-inline);
  }

  .om-mig-teaser__left {
    order: 2;
    flex-direction: column-reverse;
    padding: 1.5rem var(--padding-inline) 0;
  }
}
</style>
