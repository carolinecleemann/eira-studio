---
import BaseLayout from '../layouts/BaseLayout.astro';

const items = [
  {
    title: 'Skriv til mig',
    body: 'Du er velkommen til at skrive, hvis du har spørgsmål eller ønsker at høre mere om et forløb.',
    cta: { label: 'Mail', href: 'mailto:Kirstencleemann.eirastudio@gmail.com' },
  },
  {
    title: 'Ring til mig',
    body: 'Hvis du foretrækker den personlige kontakt, er du velkommen til at ringe til mig for en uforpligtende samtale.',
    cta: null,
  },
  {
    title: 'Book en samtale',
    body: 'I en gratis introsamtale skaber vi et trygt første møde med plads til dine spørgsmål, tanker og behov.',
    cta: { label: 'Book', href: '/book' },
  },
];
---

<BaseLayout title="Kontakt">
  <section class="kontakt">
    {items.map((item, i) => (
      <div class="k-item" data-k={i}>
        <button class="k-trigger" aria-expanded="false" aria-controls={`k-body-${i}`}>
          <h2 class="k-title">{item.title}</h2>
          <span class="k-icon" aria-hidden="true">
            <svg class="icon-plus" width="36" height="36" viewBox="0 0 36 36" fill="none">
              <circle cx="18" cy="18" r="17" stroke="currentColor" stroke-width="1"/>
              <line x1="18" y1="11" x2="18" y2="25" stroke="currentColor" stroke-width="1" stroke-linecap="round"/>
              <line x1="11" y1="18" x2="25" y2="18" stroke="currentColor" stroke-width="1" stroke-linecap="round"/>
            </svg>
            <svg class="icon-minus" width="36" height="36" viewBox="0 0 36 36" fill="none">
              <circle cx="18" cy="18" r="17" stroke="currentColor" stroke-width="1"/>
              <line x1="11" y1="18" x2="25" y2="18" stroke="currentColor" stroke-width="1" stroke-linecap="round"/>
            </svg>
          </span>
        </button>

        <div class="k-body" id={`k-body-${i}`} aria-hidden="true">
          <div class="k-body-inner">
            <div class="k-content">
              <p class="k-text">{item.body}</p>
              {item.cta && (
                <a href={item.cta.href} class="k-cta">{item.cta.label}</a>
              )}
            </div>
          </div>
        </div>
      </div>
    ))}
  </section>
</BaseLayout>

<style>
.kontakt {
  max-width: 723px;
  padding-top: 6rem;
  background-color: var(--color-dark);
  color: var(--color-primary);
}

.k-item {
  border-bottom: 1px solid rgba(250, 247, 242, 0.2);
}

.k-trigger {
  width: 100%;
  background: none;
  border: none;
  cursor: pointer;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 1.5rem;
  padding: 2rem var(--padding-inline);
  text-align: left;
  color: var(--color-primary);
}

.k-title {
  font-family: var(--font-body);
  font-size: clamp(1.4rem, 4vw, 2.2rem);
  font-weight: 500;
  font-style: italic;
  line-height: 1.2;
  color: var(--color-primary);
}

.k-icon {
  flex-shrink: 0;
  color: var(--color-primary);
}

.icon-minus { display: none; }
.k-item.is-open .icon-plus  { display: none; }
.k-item.is-open .icon-minus { display: block; }

/* Body */
.k-body {
  display: grid;
  grid-template-rows: 0fr;
  transition: grid-template-rows 0.35s ease;
}

.k-body.is-open {
  grid-template-rows: 1fr;
}

.k-body-inner {
  overflow: hidden;
}

.k-content {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 2rem;
  padding: 0 var(--padding-inline) 2rem;
}

.k-text {
  font-family: var(--font-body);
  font-size: 0.95rem;
  line-height: 1.7;
  color: var(--color-primary);
  opacity: 0.8;
  max-width: 480px;
}

.k-cta {
  flex-shrink: 0;
  font-family: var(--font-body);
  font-size: 0.9rem;
  letter-spacing: 0.05em;
  text-transform: uppercase;
  color: var(--color-primary);
  border: 1px solid var(--color-primary);
  border-radius: 50px;
  padding: 0.65rem 2rem;
  text-decoration: none;
  transition: background-color 0.2s, color 0.2s;
}

.k-cta:hover {
  background-color: var(--color-primary);
  color: var(--color-dark);
}
</style>

<script>
document.querySelectorAll('.k-item').forEach(item => {
  const trigger = item.querySelector('.k-trigger') as HTMLButtonElement;
  const body    = item.querySelector('.k-body') as HTMLElement;

  trigger.addEventListener('click', () => {
    const isOpen = item.classList.contains('is-open');

    document.querySelectorAll('.k-item.is-open').forEach(other => {
      other.classList.remove('is-open');
      other.querySelector('.k-body')?.classList.remove('is-open');
      other.querySelector('.k-trigger')?.setAttribute('aria-expanded', 'false');
      other.querySelector('.k-body')?.setAttribute('aria-hidden', 'true');
    });

    if (!isOpen) {
      item.classList.add('is-open');
      body.classList.add('is-open');
      trigger.setAttribute('aria-expanded', 'true');
      body.setAttribute('aria-hidden', 'false');
    }
  });
});
</script>
