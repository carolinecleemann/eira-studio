---
import BaseLayout from '../layouts/BaseLayout.astro';

const items = [
  {
    title: 'Skriv til mig',
    body: 'Du er velkommen til at skrive, hvis du har spørgsmål eller ønsker at høre mere om et forløb.',
    cta: { label: 'Send mail', href: 'mailto:Kirstencleemann.eirastudio@gmail.com' },
  },
  {
    title: 'Ring til mig',
    body: 'Hvis du foretrækker den personlige kontakt, er du velkommen til at ringe til mig for en uforpligtende samtale.',
    cta: null,
  },
  {
    title: 'Book en tid',
    body: 'I en gratis introsamtale skaber vi et trygt første møde med plads til dine spørgsmål, tanker og behov.',
    cta: { label: 'Book', href: '/book' },
  },
];
---

<BaseLayout title="Kontakt" headerTheme="light" heroImage="/images/kontakt-baggrund_result.webp">
  <section class="kontakt">
    <img src="/images/kontakt-baggrund_result.webp" alt="Kontakt" class="kontakt__bg" width="297" height="371" />

    <div class="kontakt__overlay">

      <div class="kontakt__grid">
        <!-- Venstre: heading + tekst -->
        <div class="kontakt__left">
          <h1 class="kontakt__heading">Kontakt</h1>
          <p class="kontakt__body">
            Det første skridt behøver ikke være stort. Du er altid velkommen til at række ud, hvis du har spørgsmål eller ønsker at mærke efter, om et forløb føles rigtigt for dig.
          </p>
        </div>

        <!-- Højre: accordion lidt nede -->
        <div class="kontakt__accordion">
          {items.map((item, i) => (
            <div class="k-item" data-k={i}>
              <button class="k-trigger" aria-expanded="false" aria-controls={`k-body-${i}`}>
                <span class="k-title">{item.title}</span>
                <span class="k-icon" aria-hidden="true">
                  <svg class="icon-plus" width="28" height="28" viewBox="0 0 36 36" fill="none">
                    <circle cx="18" cy="18" r="17" stroke="currentColor" stroke-width="1"/>
                    <line x1="18" y1="11" x2="18" y2="25" stroke="currentColor" stroke-width="1" stroke-linecap="round"/>
                    <line x1="11" y1="18" x2="25" y2="18" stroke="currentColor" stroke-width="1" stroke-linecap="round"/>
                  </svg>
                  <svg class="icon-minus" width="28" height="28" viewBox="0 0 36 36" fill="none">
                    <circle cx="18" cy="18" r="17" stroke="currentColor" stroke-width="1"/>
                    <line x1="11" y1="18" x2="25" y2="18" stroke="currentColor" stroke-width="1" stroke-linecap="round"/>
                  </svg>
                </span>
              </button>
              <div class="k-body" id={`k-body-${i}`} aria-hidden="true">
                <div class="k-body-inner">
                  <div class="k-body-content">
                    <p class="k-text">{item.body}</p>
                    {item.cta && (
                      <a href={item.cta.href} class="k-cta">{item.cta.label}</a>
                    )}
                  </div>
                </div>
              </div>
            </div>
          ))}
        </div>
      </div>

    </div>
  </section>
</BaseLayout>


<style>
.kontakt {
  position: relative;
}

.kontakt__bg {
  width: 100%;
  height: auto;
  display: block;
  filter: blur(2px);
}

.kontakt__overlay {
  position: absolute;
  inset: 0;
  background: rgba(0, 0, 0, 0.45);
  display: flex;
  align-items: center;
  padding: 0 6rem;
}

.kontakt__grid {
  width: 100%;
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 4rem;
  align-items: start;
}

.kontakt__left {
  display: flex;
  flex-direction: column;
  gap: 20rem;
}

.kontakt__heading {
  font-family: var(--font-heading);
  font-weight: 700;
  font-size: clamp(2.5rem, 10vw, 5rem);
  text-transform: uppercase;
  color: var(--color-primary);
  line-height: 1;
}

.kontakt__body {
  width: 600px;
  font-family: var(--font-heading);
  font-weight: 400;
  font-size: 0.875rem;
  line-height: 1.8;
  color: var(--color-primary);
}

/* Accordion */
.kontakt__accordion {
  width: 100%;
  margin-top: 40rem;
}

.k-item {
  border-bottom: 1px solid rgba(255, 255, 255, 0.4);
}

.k-trigger {
  width: 100%;
  background: none;
  border: none;
  cursor: pointer;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 1.5rem;
  padding: 1rem 1.25rem;
  text-align: left;
  color: var(--color-primary);
}

.k-title {
  font-family: var(--font-body);
  font-size: 30px;
  font-weight: 700;
  font-style: normal;
  color: var(--color-primary);
}

.k-icon {
  flex-shrink: 0;
  color: var(--color-primary);
}

.icon-minus { display: none; }
.k-item.is-open .icon-plus  { display: none; }
.k-item.is-open .icon-minus { display: block; }

.k-body {
  display: grid;
  grid-template-rows: 0fr;
  transition: grid-template-rows 0.35s ease;
}

.k-body.is-open {
  grid-template-rows: 1fr;
}

.k-body-inner {
  overflow: hidden;
}

.k-body-content {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 1.5rem;
  padding: 0.75rem 1.25rem 1rem;
}

.k-text {
  font-family: var(--font-heading);
  font-weight: 400;
  font-size: 0.8rem;
  line-height: 1.7;
  color: var(--color-primary);
  opacity: 0.8;
}

.k-cta {
  flex-shrink: 0;
  font-family: var(--font-body);
  font-weight: 400;
  font-size: 0.8rem;
  color: var(--color-primary);
  border: 1px solid var(--color-primary);
  border-radius: 50px;
  padding: 0.5rem 1.5rem;
  text-decoration: none;
  transition: background-color 0.2s, color 0.2s;
}

.k-cta:hover {
  background-color: var(--color-primary);
  color: var(--color-dark);
}

@media (max-width: 767px) {
  .kontakt {
    min-height: 100vh;
  }

  .kontakt__bg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .kontakt__overlay {
    padding: 2rem 1.5rem;
    align-items: flex-start;
    padding-top: 35%;
  }

  .kontakt__grid {
    grid-template-columns: 1fr;
    gap: 0;
  }

  .kontakt__left {
    gap: 7rem;
  }

  .kontakt__accordion {
    margin-top: 10rem;
  }

  .kontakt__heading {
    font-size: 2rem;
  }

  .k-title {
    font-size: 18px;
  }

  .kontakt__body {
    font-size: 0.75rem;
    width: 70%;
  }
}
</style>

<script>
document.querySelectorAll('.k-item').forEach(item => {
  const trigger = item.querySelector('.k-trigger') as HTMLButtonElement;
  const body    = item.querySelector('.k-body') as HTMLElement;

  trigger.addEventListener('click', () => {
    const isOpen = item.classList.contains('is-open');

    document.querySelectorAll('.k-item.is-open').forEach(other => {
      other.classList.remove('is-open');
      other.querySelector('.k-body')?.classList.remove('is-open');
      other.querySelector('.k-trigger')?.setAttribute('aria-expanded', 'false');
      other.querySelector('.k-body')?.setAttribute('aria-hidden', 'true');
    });

    if (!isOpen) {
      item.classList.add('is-open');
      body.classList.add('is-open');
      trigger.setAttribute('aria-expanded', 'true');
      body.setAttribute('aria-hidden', 'false');
    }
  });
});
</script>
